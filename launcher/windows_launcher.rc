#include <windows.h>
101 ICON "../assets/atp-studio.ico"
1 RT_MANIFEST "windows_launcher.manifest"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ATP ROA Studio launcher\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "ProductName", "ATP ROA Studio\0"
            VALUE "ProductVersion", "0.1.0\0"
            VALUE "OriginalFilename", "ATP ROA Studio.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
