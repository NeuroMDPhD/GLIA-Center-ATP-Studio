        BEGIN
            VALUE "FileDescription", "GLIA Center ATP Studio launcher\0"
            VALUE "FileVersion", "0.2.0\0"
            VALUE "ProductName", "GLIA Center ATP Studio\0"
            VALUE "ProductVersion", "0.2.0\0"
            VALUE "OriginalFilename", "GLIA Center ATP Studio.exe\0"
        END
    END
    BLOCK "VarFileInfo"
